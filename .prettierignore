# ignore handlebars templates
**/*.hbs

# ignore changelog files
**/CHANGELOG.md

# ignore build tokens
/apps/docs/src/styles/koobiq/default-theme/
/apps/docs/src/assets/versions.json

# ignore docs tokens values
apps/docs/src/app/components/design-tokens-viewers/data/*.ts

# ignore public-api-guard
/tools/public_api_guard/**/*.md

# ignore auto-generated module and loader
/packages/docs-examples/example-module.ts
/packages/docs-examples/loader/index.ts

# ignores example markdown templates
/packages/docs-examples/components/markdown/**/*.html

# ignore mocks
**/mock.ts

# ignore SEO descriptions
apps/docs/src/app/seo-descriptions.ts

# ignore hooks generated by husky
/.husky/_

# ignore CODEOWNERS to keep its column alignment
/.github/CODEOWNERS

# output and caches of the separate check-angular npm project
/tools/check-angular/dist
/tools/check-angular/.angular
/tools/check-angular/.tarballs

# ignore the MCP server's committed, generated data (packages/mcp/dist/ no longer exists: `tsc`
# emits straight into the repository's own dist/, already covered by the "dist" rule above)
/packages/mcp/data/

# excerpts lifted verbatim from published .d.ts files, kept byte-for-byte so the test they back
# proves something about the real layout rather than about this repository's own style
/packages/mcp/test/fixtures/packages/**/*.d.ts
