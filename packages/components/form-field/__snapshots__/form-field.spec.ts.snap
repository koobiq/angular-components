exports[`KbqFormField should change KbqPasswordToggle icon by click 1`] = `
DebugElement {
  "nativeNode": <kbq-password-toggle
    aria-hidden="false"
    class="kbq-password-toggle"
    style="visibility: visible;"
  >
    <i
      aria-label="Скрыть пароль"
      aria-pressed="true"
      class="kbq kbq-icon-button kbq-icon kbq-contrast-fade kbq-eye-slash_16"
      role="button"
      tabindex="0"
    />
    
  </kbq-password-toggle>,
}
`;

