exports[`KbqFormField should display KbqReactivePasswordHint error for invalid password 1`] = `
DebugElement {
  "nativeNode": <kbq-reactive-password-hint
    class="kbq-reactive-password-hint kbq-hint kbq-contrast-fade kbq-hint_fill-text-off"
    id="test-reactive-password-hint-id"
  >
    <i
      class="kbq kbq-icon kbq-contrast-fade kbq-xmark-s_16"
      style="max-height: 16px;"
    />
    <span
      class="kbq-hint__text"
    >
       Min length 
       (6/8) 
      
    </span>
  </kbq-reactive-password-hint>,
}
`;

