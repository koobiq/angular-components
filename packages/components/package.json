{
    "name": "@koobiq/components",
    "version": "{{VERSION}}",
    "description": "koobiq",
    "repository": {
        "type": "git",
        "url": "https://github.com/koobiq/angular-components.git"
    },
    "keywords": [
        "angular",
        "component",
        "service",
        "directive",
        "development",
        "kit",
        "koobiq"
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/koobiq/angular-components/issues"
    },
    "homepage": "https://github.com/koobiq/angular-components#readme",
    "peerDependencies": {
        "@angular/animations": "{{NG_VERSION}}",
        "@angular/cdk": "{{NG_VERSION}}",
        "@angular/common": "{{NG_VERSION}}",
        "@angular/core": "{{NG_VERSION}}",
        "@angular/forms": "{{NG_VERSION}}",
        "@angular/platform-browser": "{{NG_VERSION}}",
        "@angular/router": "{{NG_VERSION}}",
        "@koobiq/angular-moment-adapter": "^{{VERSION}}",
        "@koobiq/angular-luxon-adapter": "^{{VERSION}}",
        "@koobiq/date-adapter": "^3.4.0",
        "@koobiq/date-formatter": "^3.2.3",
        "@koobiq/icons": ">=11.1.3 <13.0.0",
        "@koobiq/design-tokens": "^3.14.0",
        "highlight.js": "^11.11.1",
        "marked": "^17.0.0",
        "overlayscrollbars": "^2.7.3",
        "rxjs": "^7.4.0"
    },
    "peerDependenciesMeta": {
        "@angular/router": {
            "optional": true
        },
        "@koobiq/angular-moment-adapter": {
            "optional": true
        },
        "@koobiq/angular-luxon-adapter": {
            "optional": true
        },
        "highlight.js": {
            "optional": true
        },
        "marked": {
            "optional": true
        }
    },
    "dependencies": {
        "tslib": "^2.6.2"
    },
    "ng-update": {
        "packageGroup": [
            "@koobiq/components"
        ],
        "migrations": "./schematics/migrations.json"
    },
    "exports": {
        ".": {
            "sass": "./_index.scss"
        },
        "./prebuilt-themes/light-theme.css": {
            "style": "./prebuilt-themes/light-theme.css"
        },
        "./prebuilt-themes/dark-theme.css": {
            "style": "./prebuilt-themes/dark-theme.css"
        },
        "./prebuilt-themes/theme.css": {
            "style": "./prebuilt-themes/theme.css"
        }
    },
    "schematics": "./schematics/collection.json",
    "sideEffects": false
}
