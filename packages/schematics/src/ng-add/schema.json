{
    "$schema": "http://json-schema.org/schema",
    "$id": "koobiq-components-ng-add",
    "title": "koobiq-components ng-add schematic",
    "type": "object",
    "properties": {
        "project": {
            "type": "string",
            "description": "Name of the project",
            "$default": {
                "$source": "projectName"
            }
        },
        "theme": {
            "type": "string",
            "enum": ["auto", "light", "dark"],
            "default": "auto",
            "description": "The prebuilt Koobiq theme to install into angular.json and index.html.",
            "x-prompt": {
                "message": "Choose a theme to install:",
                "type": "list",
                "items": [
                    { "value": "auto", "label": "Auto — follow the OS color scheme via KbqThemeService" },
                    { "value": "light", "label": "Light" },
                    { "value": "dark", "label": "Dark" }
                ]
            }
        },
        "animations": {
            "type": "boolean",
            "default": true,
            "description": "Adds provideAnimations(), required by components that animate (dropdown, select, tooltip, toast, datepicker).",
            "x-prompt": "Set up Angular animations automatically (adds `provideAnimations()`)?"
        },
        "agents": {
            "type": "array",
            "default": [],
            "description": "AI coding agents to set the koobiq-angular skill up for (none by default). Writes .claude/skills or .agents/skills and a short managed block in AGENTS.md; see `ng generate @koobiq/components:agent-skills`.",
            "items": {
                "type": "string",
                "enum": ["claude-code", "codex", "copilot", "cursor", "gemini", "other"]
            },
            "x-prompt": {
                "message": "Set up the Koobiq skill for AI coding agents? (select none to skip)",
                "type": "list",
                "multiselect": true,
                "items": [
                    { "value": "claude-code", "label": "Claude Code (.claude/skills)" },
                    { "value": "codex", "label": "OpenAI Codex (.agents/skills)" },
                    { "value": "copilot", "label": "GitHub Copilot in VS Code (.agents/skills)" },
                    { "value": "cursor", "label": "Cursor (.agents/skills)" },
                    { "value": "gemini", "label": "Gemini CLI (.agents/skills)" },
                    { "value": "other", "label": "Another agent that reads .agents/skills" }
                ]
            }
        }
    }
}
