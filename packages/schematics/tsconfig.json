{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "rootDir": "./",
        "baseUrl": "./",
        "outDir": "dist",
        "module": "commonjs",
        "moduleResolution": "node",
        "noEmitOnError": true,
        "skipDefaultLibCheck": true,
        "types": ["node", "vitest/globals"]
    },
    "include": ["./**/*.ts"],
    // The rollup build type-checks what is included here, so the specs stay with tsconfig.spec.json and its strictness.
    "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
