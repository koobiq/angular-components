{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "rootDir": "./",
        "outDir": "dist",
        "module": "commonjs",
        "noEmitOnError": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitAny": false,
        "noImplicitThis": true,
        "noUnusedParameters": true,
        "noUnusedLocals": true,
        "skipDefaultLibCheck": true,
        "skipLibCheck": true,
        "strict": true,
        "types": ["node", "jest"]
    },
    "include": ["./**/*.ts"]
}
