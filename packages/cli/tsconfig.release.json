{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        // NodeNext, like tsconfig.lib.json: the package has no "type": "module", so the emit stays
        // CommonJS, while the "exports" maps of @octokit/rest, inquirer and commander resolve.
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "declaration": true,
        "sourceMap": true,
        "composite": false,
        "rootDir": "src/release",
        "outDir": "dist/release"
    },
    "include": ["src/release/index.ts"]
}
