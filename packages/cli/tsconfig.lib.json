{
    "compilerOptions": {
        "outDir": "../../dist/cli",
        "target": "ES2022",
        "strict": true,
        "declaration": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "downlevelIteration": true,
        "resolveJsonModule": true,
        "jsx": "preserve",
        "lib": ["esnext", "dom"],
        // NodeNext is required to resolve the "exports" maps of @octokit/rest, inquirer and
        // commander, which no longer publish a top-level "main". This package has no
        // "type": "module", so NodeNext still emits CommonJS; TypeScript 5.8 and Node 22.12+
        // both allow require() of an ES module, which is how those packages are consumed.
        "module": "nodenext",
        "moduleResolution": "nodenext"
    }
}
