{
    "compilerOptions": {
        "target": "ES2017",
        // Rollup consumes ES modules and emits the CommonJS bundle itself; "bundler"
        // resolution is what lets TypeScript read the "exports" maps of @octokit/rest,
        // inquirer and commander, which no longer publish a top-level "main".
        "module": "esnext",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        // Matches tsconfig.lib.json. Without it the ES2022-era declarations shipped by
        // @octokit/request-error fail against this config's ES2017 target.
        "skipLibCheck": true,
        "strict": true,
        "sourceMap": false,
        "composite": true,
        // TypeScript 6 no longer pulls in every installed `@types` package on its own.
        "types": [
            "node"
        ],
        "outDir": "./dist"
    },
    "include": [
        "**/*.ts"
    ],
    // Specs are compiled by jest, which supplies its own globals; this config builds the bundle and
    // must not need the test typings to do it.
    "exclude": [
        "**/*.spec.ts"
    ]
}
