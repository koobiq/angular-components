{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "declaration": true,
        "stripInternal": true,
        // Published typings must not depend on the Angular cache: see packages/components/tsconfig.lib.json.
        "incremental": false,
        "inlineSources": true,
        "types": [],
        "paths": {
            "@koobiq/components/*": ["./dist/components/*"],
            "@koobiq/angular-luxon-adapter/*": ["./dist/angular-luxon-adapter/*"],
            "@koobiq/angular-moment-adapter/*": ["./dist/angular-moment-adapter/*"]
        }
    }
}
