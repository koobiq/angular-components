{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        // Needed for Moment.js since it doesn't have a default export.
        "allowSyntheticDefaultImports": true,
        "types": ["node", "vitest/globals"],
        "paths": {
            "@koobiq/components/*": ["./dist/components/*"]
        }
    },
    "include": ["./**/*.ts"],
    // The editor finds them through packages/tsconfig.json, under the strictness of the specs.
    "exclude": ["**/*.spec.ts", "**/*.spec-helper.ts", "**/*.playwright-spec.ts"],
    "angularCompilerOptions": {
        "annotateForClosureCompiler": true,
        "flatModuleId": "@koobiq/angular-moment-adapter",
        "compilationMode": "partial"
    }
}
