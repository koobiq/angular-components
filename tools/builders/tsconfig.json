{
    "compilerOptions": {
        "outDir": "../../node_modules/@koobiq/builders",
        "declaration": true,
        "resolveJsonModule": true,
        "rootDir": ".",
        // NodeNext resolution is required to read the "exports" map of chalk 5+, which no
        // longer publishes a top-level "main". The emitted format stays CommonJS because
        // the repository's package.json has no "type": "module".
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es5",
        "types": ["node"],
        "lib": ["es2017"],
        "downlevelIteration": true
    },
    "include": ["**/*.ts", "**/*.json"],
    // Specs are compiled by jest, which supplies its own globals; this project is compiled by
    // `postinstall` to produce the builder itself, and must not need the test typings to do it.
    "exclude": ["node_modules", "dist", "tsconfig.json", "**/*.spec.ts"]
}
