{
    "compilerOptions": {
        "lib": ["es2020"],
        // NodeNext resolution is required to read glob's "exports" map. Emitted format stays
        // CommonJS because the repository's package.json has no "type": "module".
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "target": "es2020",
        "sourceMap": true,
        "types": ["node"]
    }
}
