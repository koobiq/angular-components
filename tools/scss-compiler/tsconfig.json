{
    "extends": "../../tsconfig.strict.json",
    "compilerOptions": {
        // tsconfig.strict.json leaves it off until DS-5813, and this project already passes it.
        "strictPropertyInitialization": true,
        "target": "es2020",
        "module": "NodeNext",
        "esModuleInterop": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node"]
    }
}
