{
    "extends": "../../tsconfig.strict.json",
    "compilerOptions": {
        // tsconfig.strict.json leaves it off until DS-5813, and this project already passes it.
        "strictPropertyInitialization": true,
        "target": "es2020",
        "module": "commonjs",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": [
        "**/*.ts",
        "../api-gen/rendering/entities.ts",
        "../api-gen/rendering/transforms/normalize-function-fields.ts"
    ]
}
