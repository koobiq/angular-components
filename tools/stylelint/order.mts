/**
 * Options of `order/order`: the place of every kind of node in a block, mixins included. The declarations of a block
 * override the mixins it includes, so the calls come first; a mixin that has to win over the block, as
 * `kbq-animations-off()` and `kbq-squircle()` do, wins wherever it stands. A condition or a loop comes before the
 * declarations, as it computes the variables they read, and so before the rules too: a rule that the rules of a loop
 * override goes through a mixin call, as the presets of `flex-properties-for-name()` do. The bodies of functions,
 * conditions and loops are left as written. A declaration with an interpolated name (`#{$property}: …`) is none of
 * these kinds and goes last, after the nested rules, so a mixin that needs it before them wraps it in `& { }`, as
 * `rtl()` does.
 *
 * @see https://github.com/hudochenkov/stylelint-order/blob/master/rules/order/README.md
 */
const nodeOrder: NonNullable<Config['rules']>[string] = [
    [
        'dollar-variables',
        { type: 'at-rule', name: 'extend' },
        { type: 'at-rule', name: 'include', hasBlock: false },
        // `@if`, `@else`, `@each`, `@for` and `@while`, which keep their order among themselves
        { type: 'at-rule', hasBlock: true },
        'custom-properties',
        'declarations',
        'rules',
        { type: 'at-rule', name: 'include', hasBlock: true },
        { type: 'at-rule', name: 'media' },
        { type: 'at-rule', name: 'supports' }
    ],
    { unspecified: 'bottom' }
];

/**
 * The layout of a block, which `stylelint --fix` sets: every kind of node in its place, and the declarations sorted into
 * the groups above, with the blank lines between the groups.
 */
const orderConfig: Config = {
    plugins: ['stylelint-order'],
    rules: {
        'order/order': nodeOrder,
        'order/properties-order': propertiesOrder
    }
};

export default orderConfig;
