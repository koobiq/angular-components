    "scripts": {
        "ng": "ng",
        "prepare": "husky",
        "clean": "playwright clear-cache && jest --clearCache && ng cache clean && rimraf .angular dist playwright-report .playwright-mcp test-results --verbose",
        "postinstall": "tsc -p tools/builders/tsconfig.json",
        "build:angular-moment-adapter": "ng build angular-moment-adapter",
        "build:angular-luxon-adapter": "ng build angular-luxon-adapter",
        "build:components": "ng build components",
        "build:components-experimental": "ng build components-experimental",
        "build:docs-examples-module": "ts-node --project ./tools/example-module/tsconfig.json ./tools/example-module/index.ts",
        "build:docs-examples": "ng build docs-examples",
        "build:cli": "rimraf dist/cli && rollup -c ./packages/cli/rollup.config.js && node ./packages/cli/scripts/copy-meta-to-dist.js",
        "build:tokens:data": "node ./tools/tokens/docs/index.js",
        "build:docs-content": "ts-node --project ./tools/markdown-to-html/tsconfig.json ./tools/markdown-to-html/transform-markdown.ts && yarn run docs:api-gen",
        "build:package-docs-content": "ts-node --project ./tools/package-docs-content/tsconfig.json ./tools/package-docs-content/package-docs-content.ts",
        "styles:build-all": "ts-node --project tools/scss-compiler/tsconfig.json tools/scss-compiler/scss-bundle.ts",
        "build:schematics": "rimraf packages/schematics/dist && rollup --failAfterWarnings -c packages/schematics/rollup.config.js && node ./packages/schematics/scripts/copy-meta-to-dist.js",
        "docs": "yarn run build:components && yarn run build:components-experimental && yarn run styles:build-all && yarn run build:angular-luxon-adapter && yarn run build:angular-moment-adapter && yarn run build:tokens:data && yarn run build:docs-content && yarn run build:package-docs-content && yarn run build:docs-examples-module && yarn run build:docs-examples && yarn run docs:start:dev",
        "docs:start:dev": "ng serve --configuration=development koobiq-docs",
        "docs:start:prod": "ng serve --configuration=production koobiq-docs",
        "docs:generate-sitemap": "ts-node tools/generate-sitemap.ts",
        "docs:generate-llms-txt": "ts-node tools/generate-llms-txt.ts",
        "docs:generate-prerender-routes": "ts-node tools/generate-prerender-routes.ts",
        "docs:build": "ng build koobiq-docs --configuration production",
        "docs:update-versions": "ts-node --project tools/update-doc-versions/tsconfig.json tools/update-doc-versions/update-doc-versions.ts",
        "docs:prune-is-new-badges": "ts-node tools/prune-is-new-badges",
        "docs:api-gen": "rimraf dist/api-gen && rollup -c tools/api-gen/rollup.config.js && node dist/api-gen/generate-api-docs.mjs",
        "validate:license": "ts-node --project ./tools/validate-licenses/tsconfig.json ./tools/validate-licenses/validate-licenses.ts",
        "-----RELEASE-----": "----------------------------------------------------------------------------------------",
        "release:extract-changelog": "ts-node --project tools/extract-release-notes/tsconfig.json tools/extract-release-notes",
        "release:extract-docs-meta": "yarn run docs:generate-sitemap && yarn run docs:generate-prerender-routes && yarn run docs:generate-llms-txt",
        "release:stage": "yarn run release:extract-docs-meta && ts-node --project packages/cli/tsconfig.lib.json packages/cli/src/cli stage",
        "release:stage:commit": "yarn run docs:prune-is-new-badges && yarn run release:extract-docs-meta && ts-node --project packages/cli/tsconfig.lib.json packages/cli/src/cli stage-commit",
        "release:publish:ci": "ts-node --project packages/cli/tsconfig.lib.json packages/cli/src/cli publish-ci",
        "release:publish:dist": "ts-node --project p packages/cli/tsconfig.lib.json packages/cli/src/cli publish-dist",
        "release:publish:ci-gitlab": "ts-node --project packages/cli/tsconfig.lib.json packages/cli/src/cli publish-ci-gitlab",
        "release:publish:ci-github": "ts-node --project packages/cli/tsconfig.lib.json packages/cli/src/cli publish-ci-github",
