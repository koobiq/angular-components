{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["node", "jest"]
    },
    "include": [
        "**/*.spec.ts",
        "**/*.d.ts"
    ],
    "angularCompilerOptions": {
        "extendedDiagnostics": {
            "checks": {
                "nullishCoalescingNotNullable": "suppress",
                "optionalChainNotNullable": "suppress"
            }
        }
    }
}
